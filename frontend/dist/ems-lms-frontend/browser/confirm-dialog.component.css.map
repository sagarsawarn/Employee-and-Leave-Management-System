
      .backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: var(--space-4);
      }
      .dialog {
        background: var(--color-surface);
        border-radius: var(--radius);
        padding: var(--space-5);
        max-width: 400px;
        width: 100%;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
      }
      .dialog-title {
        margin: 0 0 var(--space-2);
        font-size: 1.1rem;
      }
      .dialog-message {
        margin: 0 0 var(--space-5);
        font-size: 0.9rem;
      }
      .dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: var(--space-2);
      }
    