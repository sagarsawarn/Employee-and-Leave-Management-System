
      .empty {
        text-align: center;
        padding: var(--space-6) var(--space-4);
        color: var(--color-muted);
      }
      .empty-title {
        font-weight: 600;
        color: var(--color-text);
        margin-bottom: var(--space-1);
      }
      .empty-message {
        margin: 0 0 var(--space-4);
        font-size: 0.9rem;
      }
    